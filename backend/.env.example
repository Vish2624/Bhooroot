# ─── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────
# Get free cluster at https://cloud.mongodb.com
MONGO_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/farmbasket?retryWrites=true&w=majority

# ─── JWT ──────────────────────────────────────────────────
# Generate a long random string: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_string_here
JWT_EXPIRE=30d

# ─── Razorpay ─────────────────────────────────────────────
# Get keys at https://dashboard.razorpay.com/app/keys
# Use rzp_test_ keys for development, rzp_live_ for production
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# ─── Frontend URL (CORS) ───────────────────────────────────
CLIENT_URL=http://localhost:5500
